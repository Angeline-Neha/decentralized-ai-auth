# Gateway listens here
PORT=3001

# Hardhat local node (run `npm run chain` first)
RPC_URL=http://127.0.0.1:8545

# Hardhat account #1 — funded relayer that submits agent intents
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78627d

# Written by `npm run deploy`
DEPLOYMENT_PATH=../contracts/deployments/localhost.json

# SQLite database (created automatically; uses Node built-in node:sqlite)
DB_PATH=./data/gateway.db

# Mock provider credentials (never exposed to the agent)
MOCK_EMAIL_API_KEY=demo-email-key
MOCK_CALENDAR_API_KEY=demo-calendar-key

# Enable POST /dev/* routes (advance time, tamper audit row)
DEV_MODE=true
