# Used by npm start (scripts/dev-all.mjs)
# Start Ganache first, then npm start

# Ganache GUI defaults (change if your Ganache uses different host/port/id)
RPC_URL=http://127.0.0.1:7545
CHAIN_ID=5777
DEPLOY_NETWORK=ganache

# Set to 1 only if you use Hardhat node instead of Ganache
START_HARDHAT_NODE=0
